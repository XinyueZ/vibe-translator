# Google Cloud VertexAI Configuration
# Google GenAI Configuration
# Set to 'True' to use Vertex AI (requires gcloud auth and Google Cloud project setup)
# Set to 'False' to use Google AI Studio API Key
GOOGLE_GENAI_USE_VERTEXAI=False

# ----------------------------------------------------
# OPTION 1: Google AI Studio (If USE_VERTEXAI=False)
# ----------------------------------------------------
GOOGLE_AI_STUDIO_API_KEY=your_api_key_here

# ----------------------------------------------------
# OPTION 2: Google Cloud Vertex AI (If USE_VERTEXAI=True)
# ----------------------------------------------------
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global

# ----------------------------------------------------
# Model Configuration
# ----------------------------------------------------
GEMINI_MODEL=gemini-3.1-flash-lite-preview
\n# ----------------------------------------------------\n# Ollama Local AI Configuration\n# ----------------------------------------------------\nOLLAMA_HOST=http://localhost:11434\nOLLAMA_MODEL=qwen3:8b
